PORT=4200

# Mismo tenant y audiencia que el back (valida el mismo JWT de Entra ID)
AZURE_TENANT_ID=635fce4d-bfca-4393-994d-91819d9056e1
AZURE_AUDIENCE=37a0afef-4a92-4f3b-a448-585c7994cb08

CORS_ORIGINS=http://localhost:5173,https://pedidos360-front.vercel.app

# API HTTP de RabbitMQ Management.
# Local: http://localhost:15672 (guest/guest, vhost /)
# CloudAMQP: https://<host>.rmq.cloudamqp.com (usuario y clave de la instancia;
# el vhost en CloudAMQP es igual al usuario)
RABBITMQ_MANAGEMENT_URL=http://localhost:15672
RABBITMQ_MANAGEMENT_USER=guest
RABBITMQ_MANAGEMENT_PASSWORD=guest
RABBITMQ_VHOST=/
